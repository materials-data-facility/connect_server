# MDF Connect v2 Backend — Local Development Environment Variables
# Copy to .env and modify as needed. python-dotenv loads these automatically.

# Store backend: sqlite (local dev) or dynamodb (prod)
STORE_BACKEND=sqlite
SQLITE_PATH=/tmp/mdf_connect_v2.db

# Storage backend: local (local dev) or s3 (prod)
STORAGE_BACKEND=local
LOCAL_STORAGE_PATH=/tmp/mdf_storage

# Auth mode: dev (X-User-Id headers) or production (Globus token introspection)
AUTH_MODE=dev

# Async job dispatch: inline (local dev) or sqs (prod)
ASYNC_DISPATCH_MODE=inline

# Curation settings
ALLOW_ALL_CURATORS=true
CURATOR_GROUP_IDS=
REQUIRED_GROUP_MEMBERSHIP=

# Mock external services for local dev
USE_MOCK_DATACITE=true
USE_MOCK_SEARCH=true

# Default organization
# DEFAULT_ORGANIZATION=MDF

# API Gateway stage prefix (Lambda only)
# ENVIRONMENT=staging
